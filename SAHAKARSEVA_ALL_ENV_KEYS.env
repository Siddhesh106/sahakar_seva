# ==============================================================================
#                      SAHAKARSEVA — MASTER CONSOLIDATED ENV CONFIG
#             (All Frontend + Backend Environment Variables in One File)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel)
# ------------------------------------------------------------------------------
# Put this in Vercel Dashboard -> Settings -> Environment Variables
# Or save in frontend-customer/.env

# URL of your deployed backend API server
# (Leave empty during local development to use the Vite proxy at http://localhost:3000)
VITE_API_URL=https://sahakar-seva-backend.onrender.com


# ------------------------------------------------------------------------------
# 2. BACKEND DATABASE & CLOUD (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection strings for Prisma ORM & Supabase Database

# Pooled Database URL (used for application queries)
DATABASE_URL="postgresql://postgres:Siddhesh%40903@db.yvwirgxhufregpjksgkr.supabase.co:5432/postgres"

# Direct Unpooled Database URL (used for Prisma migrations and schema push)
DIRECT_URL="postgresql://postgres:Siddhesh%40903@db.yvwirgxhufregpjksgkr.supabase.co:5432/postgres"

# Supabase Project Base URL
SUPABASE_URL="https://yvwirgxhufregpjksgkr.supabase.co"


# ------------------------------------------------------------------------------
# 3. BACKEND AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens

JWT_SECRET="sahakarseva-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Master OTP for instant login bypass / demo mode (OTP: 123456)
MOCK_OTP="123456"


# ------------------------------------------------------------------------------
# 4. BACKEND SERVER CONFIGURATION (Node / Express)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"


# ------------------------------------------------------------------------------
# 5. META WHATSAPP CLOUD API (Optional — for WhatsApp Dispatch Bot)
# ------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN="sahakarseva-whatsapp-verify"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""


