# ================================================================
# SahakarSeva Environment Configuration
# SIH26089: Cooperative Gig Services Platform
# ================================================================

# Port Configuration
PORT=3000

# JWT Authentication
JWT_SECRET=sahakarseva-production-super-secret-key-replace-me
JWT_EXPIRES_IN=7d

# Demo Mode (Bypasses external SMS/Payment gateways with simulated success)
DEMO_MODE=true
MOCK_OTP=123456

# ----------------------------------------------------------------
# Database: Supabase Postgres (Prisma Datasource Configuration)
# ----------------------------------------------------------------
# 1. Runtime / App pooled connection (Port 6543 with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct connection for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. Supabase Project Credentials (for Realtime subscriptions)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ----------------------------------------------------------------
# Local SQLite Dev Fallback (If Supabase is not provisioned)
# ----------------------------------------------------------------
# DATABASE_URL="file:./dev.db"

# ----------------------------------------------------------------
# WhatsApp Business Cloud API (Mock mode enabled if credentials empty)
# ----------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=sahakarseva-whatsapp-verify
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
